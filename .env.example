# ==========================================
# 环境变量配置文件模板 (.env)
# ==========================================

# 1. AI 大模型配置 (用于下载小说时的内容排查、去广告与章节结构优化)
GEMINI_API_KEY="your_gemini_api_key_here"

# 或者自定义其他兼容 OpenAI 格式的大模型 (DeepSeek / Kimi / GPT 等)
AI_API_KEY="your_custom_ai_api_key_here"
AI_API_URL="https://api.openai.com/v1"
AI_MODEL="gemini-3.5-flash-lite"

# 2. 服务运行端口
PORT=3000

# 3. 独立绑定域名 (例如 qidu.eu.org)
DOMAIN="your domian"

# 4. MySQL 数据库配置 (多用户及书架关联持久化)
# 如果未配置或连接失败，系统将自动平滑降级至本地持久化 SQL 存储引擎
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DATABASE="novel_reader"

# 5. 多用户会话安全签名密匙 (JWT Secret)
JWT_SECRET="tt-novel-multiuser-secret-key-2026"
